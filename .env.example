# ─────────────────────────────────────────────
# MYNVORA — WEB APP ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────

# App
VITE_APP_NAME=
VITE_APP_ENV=

# API
VITE_API_BASE_URL=
VITE_WS_URL=

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Apple Sign-In
VITE_APPLE_CLIENT_ID=

# Location
VITE_DEFAULT_GEOHASH_LENGTH=
VITE_LIVE_PRECISION_ENABLED=

# Feature flags
VITE_ENABLE_DEVTOOLS=
VITE_ENABLE_MOCK_DATA=